# ═════════════════════════════════════════════════════════════════════════════
# TuringOne Community Edition — Configuration
#
# ⚡ Démarrage rapide : lancez ./install.sh (ou .\install.ps1 sous Windows).
#    Le script copie ce fichier vers .env et remplace chaque __GENERATE__
#    par un secret aléatoire fort. Ne commitez JAMAIS le fichier .env généré.
#
# 🔑 TURINGONE_MASTER_KEY chiffre les clés privées de TOUS les projets :
#    si vous la perdez, les credentials stockés (JIRA, Xray, Azure, auth API…)
#    sont IRRÉCUPÉRABLES. Sauvegardez .env avec vos backups de base de données.
# ═════════════════════════════════════════════════════════════════════════════

# ── Édition & chiffrement ────────────────────────────────────────────────────
TURINGONE_EDITION=community
# Provider de clés projets : local = paire RSA-4096 générée sur place,
# clé privée chiffrée par la master key (aucune dépendance AWS KMS).
KMS_PROVIDER=local
# 32 octets aléatoires en base64 url-safe — générée par install.sh.
TURINGONE_MASTER_KEY=__GENERATE_URLSAFE__

# ── Tenant unique de l'installation ──────────────────────────────────────────
# TENANT_NAME = nom du realm Keycloak = nom de la base PostgreSQL = bucket S3.
# Minuscules/chiffres uniquement. Le frontend DOIT être visité sur un hostname
# dont le premier label est ce nom (ex. http://community.localhost:5173).
# ⚠️ Si vous le changez, mettez aussi à jour : DATABASE_NAME, TENANT_DBS,
#    FRONTEND_URL, LIMITS_FRONTEND_URL et CORS_ALLOWED_ORIGINS (même valeur).
TENANT_NAME=community
TENANT_DISPLAY_NAME=TuringOne Community
TENANT_CONTACT_EMAIL=admin@example.com
COMMUNITY_PLAN_KEY=community

# ── Administrateur applicatif (créé dans Keycloak par le bootstrap) ──────────
TURINGONE_ADMIN_USERNAME=admin
TURINGONE_ADMIN_PASSWORD=__GENERATE__

# ── URLs publiques (vues du NAVIGATEUR de l'utilisateur) ─────────────────────
# *.localhost pointe automatiquement vers 127.0.0.1 sur les navigateurs modernes.
FRONTEND_URL=http://community.localhost:5173
PUBLIC_API_URL=http://localhost:8000
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Ports publiés sur la machine hôte
FRONTEND_PORT=5173
BACKEND_PORT=8000
KEYCLOAK_PORT=8080

# ── PostgreSQL (interne au réseau Docker — jamais exposé) ────────────────────
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=turingone
DATABASE_PASSWORD=__GENERATE__
# Base par défaut (fallback mono-tenant) = base du tenant
DATABASE_NAME=community

# Base billing (tenants, licences, quotas IA) — même serveur, même rôle.
BILLING_DATABASE_HOST=postgres
BILLING_DATABASE_PORT=5432
BILLING_DATABASE_USER=turingone
BILLING_DATABASE_PASSWORD=__GENERATE_SAME_AS_DATABASE_PASSWORD__
BILLING_DATABASE_NAME=turingone

# ── Keycloak ─────────────────────────────────────────────────────────────────
# URL INTERNE (résolution Docker) — le navigateur utilise KEYCLOAK_PUBLIC_URL.
KEYCLOAK_SERVER=http://keycloak:8080
KEYCLOAK_CLIENT_ID=turingone-frontend
# Requis par la config mais non utilisé (clients publics uniquement)
KEYCLOAK_CLIENT_SECRET=not-used-public-clients
KEYCLOAK_USERNAME_ADMIN=admin
KEYCLOAK_PASSWORD_ADMIN=__GENERATE__
# Mot de passe de la base dédiée Keycloak
KC_DB_PASSWORD=__GENERATE__
LOGIN_THEME=turingone

# RabbitMQ — false quand le broker et le worker (jobs) ne sont pas déployés.
# Les producteurs deviennent alors des no-op tracés, sans erreur.

# ── Redis (cache LLM, interne — optionnel, dégradation propre) ───────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# ── S3 / MinIO (interne — jamais exposé) ─────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=__GENERATE_KEYID__
S3_SECRET_KEY=__GENERATE__
# "turingone" = valeur historique attendue par certains modules — ne pas changer
S3_BUCKET=turingone
S3_REGION_NAME=us-east-1
# Cache local des fichiers S3 dans le conteneur (volume /data)
S3_CACHE_DIR=/data/s3-cache

# ── LLM / IA ─────────────────────────────────────────────────────────────────
# TuringOne parle à tout serveur "OpenAI-compatible" (/v1/chat/completions) :
#   Option A (défaut) : OpenAI cloud — renseignez VLLM_API_KEY avec votre clé.
#   Option B : serveur local (Ollama, vLLM, LM Studio, LiteLLM…) — ex. :
#       LLM_FAST_URL=http://host.docker.internal:11434/v1
# ── Fournisseur LLM externe unique ───────────────────────────────────────────
# Renseigner LLM_API_URL bascule TOUTE l'inférence (fast / reasoning / code)
# vers un seul endpoint externe compatible OpenAI : aucun modèle de génération
# ne tourne sur ce serveur. Les trois blocs LLM_*_URL ci-dessous sont alors
# ignorés. Laisser vide pour conserver le routage par tiers.
LLM_API_URL=
LLM_API_TOKEN=
LLM_MODEL=

VLLM_API_KEY=CHANGE-ME-openai-api-key

OPENAI_API_KEY=

# ── URLs applicatives & CORS ─────────────────────────────────────────────────
# URL interne de l'API (appels service→service)
API_BASE_URL=http://backend:8000
API_TOKEN=
LIMITS_FRONTEND_URL=http://community.localhost:5173
CORS_ALLOWED_ORIGINS=http://community.localhost:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
SIGNALING_URL=ws://localhost:8000/stream-ui/send
WEBRTC_SIGNAL_URL=ws://localhost:8000/webrtc-signal
CDN_BASE_URL=

# ── SSL sortant (httpx/boto3 → Keycloak/MinIO internes en HTTP) ──────────────
SSL_VERIFY=false
SSL_CERT_PATH=

# ── Workers & exécution des tests ────────────────────────────────────────────
TENANT_DBS=community
WORKERS_PER_TENANT=1
EXECUTION_FRAMEWORK_URL=
# github : les tests générés sont poussés dans VOTRE repo Git et exécutés par
#          votre CI (GitHub Actions / GitLab CI / Azure Pipelines) — recommandé.
# local  : nécessite le socket Docker dans le conteneur backend (non fourni
#          par défaut — voir SECURITY.md avant de l'activer).
EXECUTION_MODE=github

# ── Observabilité (désactivée en community) ──────────────────────────────────
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://localhost:5001

# ── SMTP (optionnel — emails de bienvenue ; sans config, simple warning) ─────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Divers ───────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# TuringOne Community Registry — enregistrement des utilisateurs Community
# dans un environnement EXTERNE (API séparée, hors de cette installation).
#
# Appelée uniquement par le backend : ni l'URL ni le token n'atteignent jamais
# le navigateur. Laisser ENABLED=false pour lancer TuringOne Community en local
# sans dépendre du service externe — aucun appel n'est alors émis.
#
# ⚠️  Ne JAMAIS committer de vraie valeur de token dans ce fichier.
# ═════════════════════════════════════════════════════════════════════════════

# Limite de cas de test UI par projet (edition Community). 0 = illimite.
# Appliquee par le bouton Synchronize : la generation s'arrete a la capacite restante.
